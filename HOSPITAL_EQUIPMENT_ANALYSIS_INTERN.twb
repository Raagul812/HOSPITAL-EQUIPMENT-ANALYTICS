      <aliases enabled='yes' />
      <column caption='Actual Usage Hours' datatype='real' name='[Actual_Usage_Hours]' role='measure' type='quantitative' />
      <column caption='Utilization%' datatype='real' name='[Calculation_2068189314002944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Actual_Usage_Hours]/[Scheduled_Hours])*100' />
      </column>
