      <column caption='hospital_equipment_analysis' datatype='table' name='[__tableau_internal_object_id__].[hospital_equipment_analysis_2F424DE60FB84B94872B892A114C31CD]' role='measure' type='quantitative' />
      <column caption='ï»¿Equipment ID' datatype='string' name='[ï»¿Equipment_ID]' role='dimension' type='nominal' />
      <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
      <column-instance column='[Downtime_Reason]' derivation='None' name='[none:Downtime_Reason:nk]' pivot='key' type='nominal' />
      <column-instance column='[Maintenance_Type]' derivation='None' name='[none:Maintenance_Type:nk]' pivot='key' type='nominal' />
      <group caption='Action (Equipment Name)' hidden='true' name='[Action (Equipment Name)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Equipment_Name]' />
        </groupfilter>
      </group>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Downtime_Reason:nk]' palette='purple_10_0' type='palette'>
            <map to='#7c4d79'>
              <bucket>&quot;Software Glitch&quot;</bucket>
            </map>
            <map to='#8a5d8a'>
              <bucket>&quot;Scheduled Maintenance&quot;</bucket>
            </map>
            <map to='#9d6d97'>
              <bucket>&quot;Power Failure&quot;</bucket>
            </map>
            <map to='#b37ca1'>
              <bucket>&quot;Part Replacement&quot;</bucket>
            </map>
            <map to='#c38eb1'>
              <bucket>&quot;Operator Unavailable&quot;</bucket>
            </map>
            <map to='#d2a1c1'>
              <bucket>&quot;None&quot;</bucket>
            </map>
            <map to='#e2b4d4'>
              <bucket>&quot;Malfunction&quot;</bucket>
            </map>
            <map to='#eec9e5'>
              <bucket>&quot;Calibration&quot;</bucket>
            </map>
          </encoding>
